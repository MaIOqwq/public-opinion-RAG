# Flask Configuration
FLASK_ENV=development

# ChromaDB Configuration
CHROMA_PATH=./chroma_db
COLLECTION_NAME=game_opinions

# LLM Provider
# Supported: deepseek, qwen
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
QWEN_API_KEY=sk-your-qwen-api-key

# Model Parameters
TEMPERATURE=0.3
MAX_TOKENS=500

# RAG Parameters
TOP_K=15
CONTEXT_MAX_LENGTH=4000

# Hybrid Search
BM25_ENABLED=true
HYBRID_TOP_K=20
RRF_K=60

# Structured Filter (LLM-based filter extraction)
STRUCTURED_FILTER_ENABLED=true

# Query Expansion (game-domain synonym injection for BM25)
QUERY_EXPANSION_ENABLED=true

# Time Decay (down-weight old documents)
TIME_DECAY_ENABLED=true
TIME_DECAY_HALF_LIFE_DAYS=30

# Hot-Score Boost (boost docs with high engagement)
HOT_BOOST_ENABLED=true

# Deduplication
DEDUP_ENABLED=true

# Diversity (cap results per game)
DIVERSITY_ENABLED=true
DIVERSITY_MAX_PER_GAME=3
